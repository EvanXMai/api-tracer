{
  "manifest_version": 3,
  "name": "ApiTracer",
  "version": "1.1.0",
  "description": "前端请求语义化追踪。配合 api-tracer-ast，在 DevTools 中以业务函数名维度查看接口请求。",
  "minimum_chrome_version": "102",
  "devtools_page": "devtools/devtools.html",
  "icons": {
    "16": "icons/logo.png",
    "32": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/logo.png",
      "32": "icons/logo.png",
      "48": "icons/logo.png",
      "128": "icons/logo.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "sandbox": {
    "pages": ["sandbox/sandbox.html"]
  }
}
